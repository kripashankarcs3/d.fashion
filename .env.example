# Frontend environment configuration
# Most values below have sensible default fallbacks baked into src/config/*;
# set them to override the brand identity, contact details, and marketing data
# per environment (staging vs production vs white-label).
# IMPORTANT: YouCam API credentials must NOT be set here — the Express
# server proxies all YouCam calls server-side (Requirement 2).
VITE_API_BASE_URL=http://localhost:3001/api

# Absolute site origin for canonical URLs, Open Graph, and sitemap.xml
# (src/config/navigation.ts). Leave unset in dev; set at build time for prod.
# VITE_SITE_URL=https://deestyle.example.com

# Brand identity (defaults in src/config/site.ts)
VITE_BRAND_NAME=D'Fashion
VITE_STYLIST_NAME=D'Style
VITE_BRAND_TAGLINE=Colour Intelligence, Personalised.
VITE_BRAND_STRAPLINE=Discover the colours that were made for you.
VITE_BRAND_LOGO=/images/campaign/logo3.png

# Contact + socials (defaults in src/config/site.ts)
VITE_SUPPORT_EMAIL=hello@deestyle.example.com
VITE_CONTACT_EMAIL=hello@dfashion.app
VITE_INSTAGRAM_HANDLE=@dfashion.app
VITE_RESPONSE_TIME=Within 2 working days
VITE_RESPONSE_TIME_DETAIL=Usually within two working days.
VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/
VITE_SOCIAL_PINTEREST=https://www.pinterest.com/
VITE_SOCIAL_YOUTUBE=https://www.youtube.com/
VITE_SOCIAL_X=https://x.com/

# Languages (JSON array of { code, label }) + default (src/config/site.ts)
# VITE_LANGUAGE_OPTIONS=[{"code":"en-US","label":"English (US)"},{"code":"hi-IN","label":"हिन्दी"}]
VITE_DEFAULT_LANGUAGE=en-US

# SEO share image (extension-less-relative path; src/config/site.ts + seo.ts)
VITE_OG_IMAGE=/images/campaign/opening-og.jpg

# Style-preview swatches rendered on marketing surfaces (comma-separated hexes)
VITE_PALETTE_PREVIEW=#C19A6B,#B8974A,#3E6B5E,#8B4513,#D4AF71

# Pricing (defaults in src/config/pricing.ts)
VITE_CURRENCY_LOCALE=en-IN
VITE_CURRENCY_SYMBOL=₹
VITE_ANNUAL_PAID_MONTHS=10

# Firebase Web SDK config for real email/password auth
# Enable Google sign-in in Firebase Console → Authentication → Sign-in method.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
