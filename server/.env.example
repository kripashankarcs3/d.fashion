# ── Server configuration ──
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Auth (required — generate a long random string, e.g. `openssl rand -base64 32`) ──
JWT_SECRET=replace-with-a-long-random-string

# ── Database (required) ──
MONGODB_URI=mongodb://localhost:27017/deestyle

# ── YouCam AI API credentials (required for real image analysis & try-on) ──
# The S2S API authenticates with the API key alone (Bearer token).
YOUCAM_API_KEY=your-youcam-api-key-here

# YouCam integration tuning (defaults shown — set only to override)
# YOUCAM_BASE_URL=https://yce-api-01.perfectcorp.com
# YOUCAM_TIMEOUT_MS=120000
# YOUCAM_POLL_MAX_RETRIES=30
# YOUCAM_POLL_INTERVAL_MS=2000
# YOUCAM_TASK_MAX_RETRIES=20
# YOUCAM_TASK_INTERVAL_MS=2500
# YOUCAM_TEMPLATE_PAGE_SIZE=20

# ── OpenCode (optional — powers the stylist chat) ──
# Without it configured, the chat answers from the built-in rules engine.
#
# OPENCODE_MODE=zen    → calls the Zen API directly. Needs OPENCODE_API_KEY
#                        (https://opencode.ai/auth) and billing on the
#                        workspace. OPENCODE_MODEL must be served on
#                        /chat/completions: deepseek-v4-flash, glm-5.3,
#                        kimi-k2.6, minimax-m3, ... (not GPT/Claude).
# OPENCODE_MODE=server → goes through a local `opencode serve`, which is where
#                        free models such as big-pickle work. Start it with
#                        `npm run stylist:serve` in server/, or — in the
#                        Docker/Render image — the container's entrypoint runs
#                        `opencode serve` on loopback itself; point it at the
#                        machine's auth with OPENCODE_AUTH_B64 (base64 of
#                        ~/.local/share/opencode/auth.json) plus
#                        OPENCODE_SERVER_PASSWORD.
# OPENCODE_MODE=server
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=deepseek-v4-flash
# OPENCODE_MAX_TOKENS=1024
# OPENCODE_TIMEOUT_MS=25000
# OPENCODE_ZEN_MAX_RETRIES=4   # retries with backoff when Zen throttle-bursts 429s
#
# Server mode — required: a long random password shared with the server.
# OPENCODE_SERVER_PASSWORD=
# OPENCODE_SERVER_URL=http://127.0.0.1:4096
# OPENCODE_SERVER_USERNAME=opencode
# Empty folder the sessions run in (default: <system temp>/deestyle-stylist).
# OPENCODE_SERVER_DIRECTORY=
# Docker/Render only: base64 of ~/.local/share/opencode/auth.json, so the
# container's `opencode serve` uses the machine's OpenCode login.
# OPENCODE_AUTH_B64=

# ── Brand / persona used in server-side copy (Stylist) ──
# PRODUCT_NAME=D'Fashion
# STYLIST_NAME=D'Style

# ── Uploads ──
# UPLOAD_MAX_BYTES=10485760
# UPLOAD_TTL_MS=7200000

# ── Plans: try-on limits + who can review payments ──
# TRY_ON_LIMIT_STARTER=9        # free plan, lifetime
# TRY_ON_LIMIT_ESSENTIALS=40    # granted when an Essentials payment is approved
#                                 # (Atelier is unconditionally unlimited — no env var)
# Comma-separated emails allowed to approve/reject payments and manage
# products. Must match the email on the Firebase account you sign in with.
# ADMIN_EMAILS=you@example.com

# ── Payment alert email (optional) ──
# Emails whoever reviews payments as soon as one is submitted. Unset = no
# email is sent; the payment still lands in /admin/payments either way.
# SMTP_USER is a Gmail address; SMTP_APP_PASSWORD is a Gmail *App Password*
# (myaccount.google.com/apppasswords — needs 2-Step Verification turned on
# first), never the account's real login password.
# SMTP_USER=you@gmail.com
# SMTP_APP_PASSWORD=
# Who receives the alert. Defaults to the first address in ADMIN_EMAILS.
# NOTIFY_EMAIL=you@example.com

# ── Rate limiting (windows in ms, max requests per window) ──
# RATE_LIMIT_API_WINDOW_MS=60000
# RATE_LIMIT_API_MAX=100
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AI_HEAVY_WINDOW_MS=3600000
# RATE_LIMIT_AI_HEAVY_MAX=8
# RATE_LIMIT_AI_LIGHT_WINDOW_MS=3600000
# RATE_LIMIT_AI_LIGHT_MAX=40
# RATE_LIMIT_CHAT_WINDOW_MS=3600000
# RATE_LIMIT_CHAT_MAX=60
# RATE_LIMIT_PAYMENT_WINDOW_MS=3600000
# RATE_LIMIT_PAYMENT_MAX=10

# ── Content Security Policy: extra image hosts (comma-separated) ──
# CSP_IMG_HOSTS=https://images.unsplash.com,https://*.youcamcdn.com,https://*.perfectcorp.com,https://lh3.googleusercontent.com

# ── Firebase Admin SDK (required for verifying Firebase ID tokens on the server) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
